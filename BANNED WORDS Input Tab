function modifier(text) {

    let command = text.trim().toLowerCase();

    //  TURN FILTER OFF
    //  command is what is put in the story to toggle use of words on/off. (orange words between "quotations")
    //  Best to use something like a command and not something that would accidentally be inputted 
    //  allow_bannedwords_on vs. allow banned words. 
    if (command === "allow_bannedwords_on") {

        state.banWords = false;

    //  RETURN is what the Adventure will say when the command is entered
        return {
            text: " ☢️ FILTER SETTINGS: Banned words filter is now OFF. "
        };
    }


    // TURN FILTER ON
    if (command === "allow_bannedwords_off") {

        state.banWords = true;

        return {
            text: " FILTER SETTINGS: Banned words filter is now ON. "
        };
    }


    // BLOCK PLAYER INPUT
    //Message if user tries to input BANNED word or phrase
    if (checkBannedWords(text)) {

        return {
            text:
`[Your input contains a blocked word.

Please rewrite your message.]`
        };

    }

    return {
        text: text
    };
}

