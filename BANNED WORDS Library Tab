if (state.banWords === undefined) {
    state.banWords = true;
}

// BANNED WORD FILTER list
// List off the words you don't want users to be able to put here. 
// In ""s and separated by , 
// Last word in the list does NOT need a , after it.
const BANNED_WORDS = [
    "piss",
    "slut",
    "cunt",
    "whore",
    "fuck",
    "🖕",
    "shit",
    "damn"
];


function checkBannedWords(text) {

    if (state.banWords === false) {
        return false;
    }

    for (let word of BANNED_WORDS) {

        if (text.toLowerCase().includes(word)) {
            return true;
        }

    }

    return false;
}

function replaceBannedWords(text) {

    if (state.banWords === false) {
        return text;
    }

    for (let word of BANNED_WORDS) {

        let regex = new RegExp(word, "gi");

        text = text.replace(regex, "[BLOCKED]");
    }


    return text;
}
